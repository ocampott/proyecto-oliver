PORT=3001
CORS_ORIGIN=http://localhost:5173
# Poner en "true" SOLO en dev, para aceptar CORS desde cualquier puerto
# localhost (Vite puede correr en un puerto distinto si 5173 está ocupado).
# Dejar sin setear en producción.
CORS_ALLOW_LOCALHOST=
MARCAR_BASE_URL=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Key de servidor para Google Places API (New), restringida por IP.
# Distinta de la del frontend (VITE_GOOGLE_MAPS_API_KEY, restringida por referrer).
GOOGLE_MAPS_API_KEY=
